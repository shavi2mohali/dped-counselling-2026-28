rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Development rule: signed-in admins can upload/read Excel imports.
    // Tighten this with custom admin claims before production.
    match /candidate-imports/{fileName} {
      allow read, write: if signedIn()
        && (
          request.method == 'get'
          || request.method == 'list'
          || request.resource.size < 25 * 1024 * 1024
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
