rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPublicDisplayRequest() {
      return request.auth == null;
    }

    function authEmail() {
      return signedIn()
        && request.auth.token.keys().hasAll(["email"])
        && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function hasAdminClaim() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAll(["admin"])
            && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAll(["role"])
            && request.auth.token.role == "admin")
        );
    }

    function hasAdminEmail() {
      return signedIn()
        && (
          authEmail().matches(".*@dpedpunjab[.]in$")
          || authEmail() in [
            "admin@dpedpunjab.in",
            "counselling@dpedpunjab.in"
          ]
        );
    }

    function isAdmin() {
      return hasAdminClaim() || hasAdminEmail();
    }

    function hasCollegeProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/colleges/$(request.auth.uid));
    }

    function hasCollegeClaim() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAll(["college"])
            && request.auth.token.college == true)
          || (request.auth.token.keys().hasAll(["role"])
            && request.auth.token.role == "college")
        );
    }

    function isCollege() {
      return !isAdmin() && (hasCollegeClaim() || hasCollegeProfile());
    }

    function collegeName() {
      return request.auth.token.keys().hasAll(["collegeName"])
        && request.auth.token.collegeName is string
        ? request.auth.token.collegeName
        : get(/databases/$(database)/documents/colleges/$(request.auth.uid)).data.collegeName;
    }

    function candidateBelongsToCollege() {
      return isCollege()
        && resource.data.allottedCollegeId is string
        && resource.data.allottedCollegeId == collegeName();
    }

    function collegeJoiningUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "joinedStatus",
        "joinedUpdatedAt",
        "joinedUpdatedByUid",
        "joinedUpdatedByEmail",
        "updatedAt"
      ])
      && request.resource.data.status in ["joined", "notJoined"]
      && request.resource.data.joinedStatus in ["joined", "notJoined"]
      && request.resource.data.joinedUpdatedByUid == request.auth.uid
      && request.resource.data.joinedUpdatedByEmail == authEmail();
    }

    match /candidates/{registrationId} {
      // Public display is anonymous; college queries must filter by allottedCollegeId.
      allow read: if isPublicDisplayRequest()
        || isAdmin()
        || candidateBelongsToCollege();

      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (candidateBelongsToCollege() && collegeJoiningUpdateOnly());
    }

    match /seatMatrix/{collegeName} {
      allow read: if isPublicDisplayRequest() || isAdmin() || isCollege();
      allow create, update, delete: if isAdmin();
    }

    match /colleges/{collegeUid} {
      allow read: if isAdmin()
        || (isCollege() && request.auth.uid == collegeUid);
      allow create, update, delete: if isAdmin();
    }

    match /allotments/{allotmentId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/liveCounseling {
      // Public display needs the ID of the currently called candidate.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admins/{adminUid} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
