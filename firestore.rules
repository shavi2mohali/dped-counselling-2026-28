rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Development rule: any signed-in Firebase Auth user can read/write app data.
    // Replace with custom admin claims before production launch.
    match /candidates/{registrationId} {
      allow read, write: if signedIn();
    }

    match /seatMatrix/{collegeName} {
      allow read, write: if signedIn();
    }

    match /allotments/{allotmentId} {
      allow read, write: if signedIn();
    }

    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
