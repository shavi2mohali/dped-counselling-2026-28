{
  "name": "dped-counselling-2026-28",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase + Vite React admin and live display system for DPEd 2026-28 Punjab counseling.",
  "scripts": {
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
